local function applyTheme(themeName)
    currentTheme = themeName
    local t = themes[themeName]

    for _, obj in ipairs(themeRegistry.MainFrames) do if obj and obj.Parent then obj.BackgroundColor3 = t.Main end end  
    for _, obj in ipairs(themeRegistry.TopBars) do if obj and obj.Parent then obj.BackgroundColor3 = t.TopBar end end  
    for _, obj in ipairs(themeRegistry.TopBarFixes) do if obj and obj.Parent then obj.BackgroundColor3 = t.TopBarFix end end  
    for _, obj in ipairs(themeRegistry.TopBarLines) do if obj and obj.Parent then obj.BackgroundColor3 = t.TopBarLine end end  
    for _, obj in ipairs(themeRegistry.Sidebars) do if obj and obj.Parent then obj.BackgroundColor3 = t.Sidebar end end  
    for _, obj in ipairs(themeRegistry.SidebarSeparators) do if obj and obj.Parent then obj.BackgroundColor3 = t.SidebarSep end end  
    for _, obj in ipairs(themeRegistry.FeatureFrames) do if obj and obj.Parent then obj.BackgroundColor3 = t.FeatureBg end end  
    for _, obj in ipairs(themeRegistry.TextLabels) do if obj and obj.Parent then obj.TextColor3 = t.TextMain end end  
    for _, obj in ipairs(themeRegistry.SecondaryTexts) do if obj and obj.Parent then obj.TextColor3 = t.TextHeader end end  
    for _, obj in ipairs(themeRegistry.DropFrames) do if obj and obj.Parent then obj.BackgroundColor3 = t.DropBg end end  
    for _, obj in ipairs(themeRegistry.SelectBtns) do if obj and obj.Parent then obj.BackgroundColor3 = t.SelectBtn; obj.TextColor3 = t.SelectText end end  
    for _, obj in ipairs(themeRegistry.OptBtns) do if obj and obj.Parent then obj.BackgroundColor3 = t.OptBg; obj.TextColor3 = t.OptText end end  
    for _, obj in ipairs(themeRegistry.SubContainers) do if obj and obj.Parent then obj.BackgroundColor3 = t.SeparatorLine end end  

    for name, btn in pairs(themeRegistry.TabButtons) do  
        if btn and btn.Parent then  
            if btn.TextColor3.R > 0.5 then  
                btn.BackgroundColor3 = t.TabActive  
                btn.TextColor3 = t.TabTextActive  
            else  
                btn.BackgroundColor3 = t.TabInactive  
                btn.TextColor3 = t.TabTextInactive  
            end  
        end  
    end
end

