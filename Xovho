--------------------------------------------------------------------------------
-- TEXT NORMALIZATION
--------------------------------------------------------------------------------

local function normalizeText(text)
    if text == nil then
        return ""
    end

    text = tostring(text)
    text = text:gsub("<.->", "")
    text = text:gsub("^%s+", "")
    text = text:gsub("%s+$", "")

    return text
end

local function normalizeRarity(rarity)
    rarity = normalizeText(rarity)

    for _, validRarity in ipairs(rarityList) do
        if string.lower(rarity) == string.lower(validRarity) then
            return validRarity
        end
    end

    return nil
end

--------------------------------------------------------------------------------
-- RARITY DETECTION
--------------------------------------------------------------------------------

local function getItemRarity(item)
    if not item then
        return nil
    end

    -- 1. Item attribute
    local rarity = item:GetAttribute("Rarity")

    if rarity then
        local normalized = normalizeRarity(rarity)

        if normalized then
            return normalized
        end
    end

    -- 2. Other common rarity attributes
    local attributeNames = {
        "rarity",
        "RarityName",
        "PlantRarity",
        "ItemRarity"
    }

    for _, attributeName in ipairs(attributeNames) do
        local value = item:GetAttribute(attributeName)

        if value then
            local normalized = normalizeRarity(value)

            if normalized then
                return normalized
            end
        end
    end

    -- 3. Rarity value/object inside the Tool
    local rarityObject = item:FindFirstChild("Rarity", true)

    if rarityObject then

        if rarityObject:IsA("StringValue") then
            local normalized = normalizeRarity(rarityObject.Value)

            if normalized then
                return normalized
            end
        end

        if rarityObject:IsA("TextLabel")
            or rarityObject:IsA("TextButton")
        then
            local normalized = normalizeRarity(rarityObject.Text)

            if normalized then
                return normalized
            end
        end
    end

    -- 4. Billboard
    local billboard =
        item:FindFirstChild("PlantToolBillboard", true)
        or item:FindFirstChildOfClass("BillboardGui")

    if billboard then

        for _, object in ipairs(billboard:GetDescendants()) do

            if object:IsA("TextLabel")
                or object:IsA("TextButton")
            then

                local text = normalizeText(object.Text)
                local normalized = normalizeRarity(text)

                if normalized then
                    return normalized
                end

                -- Handles text such as:
                -- "Divine Plant"
                -- "Rarity: Divine"
                for _, validRarity in ipairs(rarityList) do

                    if string.find(
                        string.lower(text),
                        string.lower(validRarity),
                        1,
                        true
                    ) then
                        return validRarity
                    end

                end
            end
        end
    end

    -- 5. Tool name fallback
    local itemName = normalizeText(item.Name)

    for _, validRarity in ipairs(rarityList) do

        if string.find(
            string.lower(itemName),
            string.lower(validRarity),
            1,
            true
        ) then
            return validRarity
        end

    end

    return nil
end

--------------------------------------------------------------------------------
-- EXACT NEXT TREE REQUIREMENT CHECK
--------------------------------------------------------------------------------

local function isExactGrowthRequirementMatch(item)

    if not item then
        return false
    end

    if not GameInfo or not GameInfo.GrowthInfo then
        return false
    end

    local currentLevel = getCurrentTreeLevel()
    local nextLevel = GameInfo.GrowthInfo[currentLevel + 1]

    if not nextLevel or not nextLevel.RequiredPlants then
        return false
    end

    local success
    local actualMutations
    local actualPlantName

    success, _, actualMutations, _, actualPlantName =
        pcall(function()
            return ItemNameParser(item.Name)
        end)

    if not success then
        return false
    end

    actualPlantName = normalizeText(actualPlantName)
    actualMutations = normalizeText(actualMutations)

    if actualPlantName == "" then
        return false
    end

    for _, requirement in ipairs(nextLevel.RequiredPlants) do

        if requirement and requirement.Name then

            local requiredName =
                normalizeText(requirement.Name)

            local requiredMutations =
                normalizeText(requirement.Mutations or "")

            if string.lower(actualPlantName)
                == string.lower(requiredName)
            then

                if mutationsMatch(
                    requiredMutations,
                    actualMutations
                ) then
                    return true
                end
            end
        end
    end

    return false
end

--------------------------------------------------------------------------------
-- PROTECTION
--------------------------------------------------------------------------------

local function isProtected(item)
    return isExactGrowthRequirementMatch(item)
end

--------------------------------------------------------------------------------
-- PLANT DETECTION
--------------------------------------------------------------------------------

local function isPlantTool(item)
    if not item or not item:IsA("Tool") then
        return false
    end

    -- Normal plant attribute
    if item:GetAttribute("isPlant") == true then
        return true
    end

    -- Other possible plant attributes
    local plantAttributes = {
        "IsPlant",
        "Plant",
        "plant",
        "PlantTool"
    }

    for _, attributeName in ipairs(plantAttributes) do
        local value = item:GetAttribute(attributeName)

        if value == true then
            return true
        end
    end

    -- plantID is another strong indicator
    if item:GetAttribute("plantID") ~= nil then
        return true
    end

    -- Try the parser as a fallback
    local success, _, _, _, plantName =
        pcall(function()
            return ItemNameParser(item.Name)
        end)

    if success and plantName then
        plantName = normalizeText(plantName)

        if plantName ~= "" then
            return true
        end
    end

    return false
end

--------------------------------------------------------------------------------
-- FULL INVENTORY SCAN
--------------------------------------------------------------------------------

local function getEntireInventory()

    local items = {}
    local seen = {}

    local function addTool(item)

        if not item then
            return
        end

        if not item:IsA("Tool") then
            return
        end

        if seen[item] then
            return
        end

        seen[item] = true
        table.insert(items, item)
    end

    -- Backpack
    local backpack =
        LocalPlayer:FindFirstChildOfClass("Backpack")

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            addTool(item)
        end
    end

    -- Equipped Character Tool
    local character = LocalPlayer.Character

    if character then
        for _, item in ipairs(character:GetChildren()) do
            addTool(item)
        end
    end

    return items
end

--------------------------------------------------------------------------------
-- SELECTED RARITY CHECK
--------------------------------------------------------------------------------

local function shouldSellRarity(item)

    local rarity = getItemRarity(item)

    if not rarity then
        return false
    end

    return selectedRarities[rarity] == true
end

--------------------------------------------------------------------------------
-- EQUIP TOOL
--------------------------------------------------------------------------------

local function equipItem(item)

    if not item then
        return false
    end

    local character = LocalPlayer.Character

    if not character then
        return false
    end

    -- Already equipped
    if item.Parent == character then
        return true
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return false
    end

    local backpack =
        LocalPlayer:FindFirstChildOfClass("Backpack")

    if not backpack then
        return false
    end

    if item.Parent ~= backpack then
        return false
    end

    local success = pcall(function()
        humanoid:EquipTool(item)
    end)

    if not success then
        return false
    end

    -- Allow the equip to replicate
    task.wait(0.08)

    -- Verify exact tool
    if item.Parent == character then
        return true
    end

    return false
end

--------------------------------------------------------------------------------
-- SELL ONE ITEM
--------------------------------------------------------------------------------

local function sellItem(item)

    if not AutoSellActive then
        return false
    end

    if not item or not item.Parent then
        return false
    end

    if not isPlantTool(item) then
        return false
    end

    -- Re-check rarity immediately before selling
    if not shouldSellRarity(item) then
        return false
    end

    -- Re-check tree protection immediately before selling
    if isProtected(item) then
        return false
    end

    local character = LocalPlayer.Character

    if not character then
        return false
    end

    -- Equip
    if not equipItem(item) then
        return false
    end

    task.wait(0.05)

    -- Verify exact equipped item
    local equippedTool =
        character:FindFirstChildWhichIsA("Tool")

    if equippedTool ~= item then
        return false
    end

    -- Final protection check
    if isProtected(item) then
        return false
    end

    -- Final rarity check
    if not shouldSellRarity(item) then
        return false
    end

    if not SellRemote then
        return false
    end

    local success = pcall(function()
        SellRemote:FireServer("equippedItem")
    end)

    if not success then
        return false
    end

    task.wait(AutoSellDelay)

    return true
end

--------------------------------------------------------------------------------
-- AUTO SELL LOOP
--------------------------------------------------------------------------------

task.spawn(function()

    while true do

        if AutoSellActive then

            pcall(function()

                -- Scan entire inventory
                local inventory = getEntireInventory()

                for _, item in ipairs(inventory) do

                    if not AutoSellActive then
                        break
                    end

                    if item and item.Parent then

                        if isPlantTool(item) then

                            if shouldSellRarity(item) then

                                if not isProtected(item) then

                                    local sold = sellItem(item)

                                    if sold then
                                        -- Stop processing the old scan.
                                        -- The next loop performs a completely
                                        -- fresh inventory scan.
                                        break
                                    end
                                end
                            end
                        end
                    end
                end

            end)

        end

        -- Fresh complete inventory scan
        task.wait(InventoryScanDelay)

    end

end)
