local function splitMutations(mutations)
    local result = {}
    for mutation in string.gmatch(mutations or "", "([^,]+)") do
        table.insert(result, mutation:match("^%s*(.-)%s*$"))
    end
    return result
end

local function mutationsMatch(requiredMutations, actualMutations)
    if (requiredMutations == "" or requiredMutations == nil) and (actualMutations == "" or actualMutations == nil) then return true end
    local required = splitMutations(requiredMutations)
    local actual = splitMutations(actualMutations)
    if #required ~= #actual then return false end
    for _, mutation in ipairs(required) do
        if not table.find(actual, mutation) then return false end
    end
    return true
end

local function doesToolMatchRequirement(tool, requirement)
    if not tool then return false end
    if tool:GetAttribute("isPlant") ~= true then return false end
    if not tool:GetAttribute("plantID") then return false end
    local _, actualMutations, _, actualPlantName = ItemNameParser(tool.Name)
    if actualPlantName ~= requirement.Name then return false end
    return mutationsMatch(requirement.Mutations or "", actualMutations or "")
end

local function playerHasRequiredPlant(requirement)
    local character = LocalPlayer.Character
    if character then
        local equippedTool = character:FindFirstChildWhichIsA("Tool")
        if doesToolMatchRequirement(equippedTool, requirement) then return true end
    end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and doesToolMatchRequirement(tool, requirement) then
                return true
            end
        end
    end
    return false
end

local function getCurrentTreeLevel()
    local treeVal = LocalPlayer:FindFirstChild("TreeLevel") or (LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("TreeLevel"))
    if treeVal then return tonumber(treeVal.Value) or 1 end
    return 1
end

local function checkRequirementsAndGrow()
    if not GameInfo or not GameInfo.GrowthInfo then return end
    local currentLevel = getCurrentTreeLevel()
    
    if lastGrowthLevel == currentLevel then return end
    
    local nextLevel = GameInfo.GrowthInfo[currentLevel + 1]
    if not nextLevel then return end
    
    if nextLevel.Cost then
        local moneyVal = LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Money")
        if not moneyVal or moneyVal.Value < nextLevel.Cost then return end
    end
    
    if nextLevel.RequiredBoss and RequestDefeatedBossesRemote then
        local success, defeatedBosses = pcall(function()
            return RequestDefeatedBossesRemote:InvokeServer()
        end)
        if not success or not defeatedBosses or defeatedBosses[nextLevel.RequiredBoss] ~= true then return end
    end
    
    if nextLevel.RequiredPlants then
        for _, req in ipairs(nextLevel.RequiredPlants) do
            if not req.Name or req.Name == "" or not playerHasRequiredPlant(req) then
                return
            end
        end
    end
    
    if RequestGrowthRemote then
        local success = pcall(function() RequestGrowthRemote:InvokeServer() end)
        if success then
            lastGrowthLevel = currentLevel
        end
    end
end

task.spawn(function()
    while true do
        if AutoGrowTree then
            pcall(function() checkRequirementsAndGrow() end)
        end
        task.wait(AutoGrowDelay)
    end
end)

