local autoSubmitBountyActive = false
local _, submitSwitch, submitCircle, submitDot, setSubmitBountyState = createFeatureToggle(Pages.Main, "Auto Submit Bounty", false, function(state)
    autoSubmitBountyActive = state
end)
setAutoSubmitBountyState = setSubmitBountyState

task.spawn(function()
    local ScanDelay = 1.5
    local BountyNames = {"EasyBillboard", "HardBillboard", "ImpossibleBillboard"}

    local function trim(str) return (str:gsub("^%s+", ""):gsub("%s+$", "")) end  
    local function normalize(str)  
        if not str then return "" end  
        str = tostring(str):gsub("%s+", " ")  
        return trim(str)  
    end  
      
    local function getBounty(billboardName)  
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")  
        local billboard = playerGui and playerGui:FindFirstChild(billboardName)  
        if not billboard then return nil end  
        local frame = billboard:FindFirstChild("Frame")  
        if not frame then return nil end  
        local difficulty = frame:FindFirstChild("Difficulty")  
        local title = frame:FindFirstChild("Title")  
        local requirements = frame:FindFirstChild("Requirements")  
        local claimed = frame:FindFirstChild("Claimed")  
        if not title or not requirements then return nil end  
        return {  
            Billboard = billboard,  
            Frame = frame,  
            Difficulty = difficulty and normalize(difficulty.Text) or billboardName,  
            Title = normalize(title.Text),  
            Requirements = normalize(requirements.Text),  
            Claimed = claimed and claimed.Visible == true or false,  
        }  
    end  
      
    local function getActiveBounties()  
        local bounties = {}  
        for _, billboardName in ipairs(BountyNames) do  
            local bounty = getBounty(billboardName)  
            if bounty and not bounty.Claimed then  
                table.insert(bounties, bounty)  
            end  
        end  
        return bounties  
    end  
      
    local function getToolSize(tool)  
        local name = tool.Name or ""  
        local size = name:match("%[([%d%.]+)x%]")  
        return size and tonumber(size) or nil  
    end  
      
    local function getNameMutation(tool)  
        local name = tool.Name or ""  
        local mutations = {}  
        for value in name:gmatch("%[([^%]]+)%]") do  
            value = normalize(value)  
            if not value:match("^%d+%.?%d*x$") then  
                table.insert(mutations, value)  
            end  
        end  
        return mutations  
    end  
      
    local function getPlantName(tool)  
        local name = tool.Name or ""  
        local cleanName = name:gsub("%[[^%]]+%]%s*", "")  
        return normalize(cleanName)  
    end  
      
    local function getPlantRarity(tool)  
        local handle = tool:FindFirstChild("Handle")  
        if not handle then return nil end  
        local billboard = handle:FindFirstChild("PlantToolBillboard")  
        if not billboard then return nil end  
        local frame = billboard:FindFirstChild("Frame")  
        if not frame then return nil end  
        local rarity = frame:FindFirstChild("Rarity")  
        if rarity and rarity:IsA("TextLabel") then  
            return normalize(rarity.Text)  
        end  
        return nil  
    end  
      
    local function getBillboardMutations(tool)  
        local mutations = {}  
        local handle = tool:FindFirstChild("Handle")  
        if not handle then return mutations end  
        local billboard = handle:FindFirstChild("PlantToolBillboard")  
        if not billboard then return mutations end  
        local frame = billboard:FindFirstChild("Frame")  
        if not frame then return mutations end  
        local mutationFrame = frame:FindFirstChild("Mutations")  
        if not mutationFrame then return mutations end  
        for _, object in ipairs(mutationFrame:GetDescendants()) do  
            if object:IsA("TextLabel") or object:IsA("TextButton") then  
                local text = normalize(object.Text)  
                if text ~= "" then table.insert(mutations, text) end  
            end  
        end  
        return mutations  
    end  
      
    local function hasMutation(tool, requiredMutation)  
        requiredMutation = normalize(requiredMutation):lower()  
        if requiredMutation == "" then return true end  
        for _, mutation in ipairs(getBillboardMutations(tool)) do  
            if mutation:lower() == requiredMutation then return true end  
        end  
        for _, mutation in ipairs(getNameMutation(tool)) do  
            if mutation:lower() == requiredMutation then return true end  
        end  
        return false  
    end  
      
    local function getRequiredSize(requirements)  
        if not requirements then return nil end  
        local size = requirements:match("%+%s*([%d%.]+)x%s*[Ss]ize")  
        if not size then size = requirements:match("([%d%.]+)x%s*[Ss]ize") end  
        return size and tonumber(size) or nil  
    end  
      
    local function getRequiredMutation(requirements)  
        if not requirements then return nil end  
        local cleaned = requirements:gsub("%+%s*[%d%.]+x%s*[Ss]ize", "")  
        cleaned = cleaned:gsub("[%d%.]+x%s*[Ss]ize", "")  
        cleaned = normalize(cleaned)  
        if cleaned == "" then return nil end  
        local ignored = {["none"] = true, ["any"] = true, ["no mutation"] = true}  
        if ignored[cleaned:lower()] then return nil end  
        return cleaned  
    end  
      
    local function matchesTitle(tool, title, rarity)  
        title = normalize(title)  
        if title == "" then return false end  
        local lowerTitle = title:lower()  
        local plantName = getPlantName(tool):lower()  
        local anyRarity = title:match("^Any%s+(.+)$")  
        if anyRarity then  
            anyRarity = normalize(anyRarity)  
            if rarity and rarity:lower() == anyRarity:lower() then return true end  
            return false  
        end  
        return plantName == lowerTitle  
    end  
      
    local function plantMatchesBounty(tool, bounty)  
        if not tool or not bounty then return false end  
        local rarity = getPlantRarity(tool)  
        if not matchesTitle(tool, bounty.Title, rarity) then return false end  
        local requiredMutation = getRequiredMutation(bounty.Requirements)  
        if requiredMutation and not hasMutation(tool, requiredMutation) then return false end  
        local requiredSize = getRequiredSize(bounty.Requirements)  
        if requiredSize then  
            local plantSize = getToolSize(tool)  
            if not plantSize or plantSize < requiredSize then return false end  
        end  
        return true  
    end  
      
    local function getAllPlants()  
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")  
        local character = LocalPlayer.Character  
        local plants = {}  
        if backpack then  
            for _, object in ipairs(backpack:GetChildren()) do  
                if object:IsA("Tool") and object:GetAttribute("isPlant") == true then  
                    table.insert(plants, object)  
                end  
            end  
        end  
        if character then  
            for _, object in ipairs(character:GetChildren()) do  
                if object:IsA("Tool") and object:GetAttribute("isPlant") == true then  
                    table.insert(plants, object)  
                end  
            end  
        end  
        return plants  
    end  
      
    local function equipTool(tool)  
        if not tool or not tool.Parent then return false end  
        local character = LocalPlayer.Character  
        if not character then return false end  
        local humanoid = character:FindFirstChildOfClass("Humanoid")  
        if not humanoid then return false end  
        humanoid:EquipTool(tool)  
        task.wait(0.15)  
        return tool.Parent == character  
    end  

    while true do  
        task.wait(ScanDelay)  
        if autoSubmitBountyActive then  
            pcall(function()  
                local activeBounties = getActiveBounties()  
                local plants = getAllPlants()  
                  
                for _, bounty in ipairs(activeBounties) do  
                    if not autoSubmitBountyActive then break end  
                    for _, plant in ipairs(plants) do  
                        if plantMatchesBounty(plant, bounty) then  
                            if equipTool(plant) then  
                                task.wait(0.2)  
                                if TurnInBountyRemote then  
                                    TurnInBountyRemote:InvokeServer()  
