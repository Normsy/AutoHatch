local function createIOSToggle(parent, defaultState, callback)
    local SwitchBtn = Instance.new("TextButton")
    SwitchBtn.Parent = parent
    SwitchBtn.BackgroundColor3 = defaultState and Color3.fromRGB(52, 199, 89) or Color3.fromRGB(35, 35, 35)
    SwitchBtn.Position = UDim2.new(1, -42, 0.5, -9)
    SwitchBtn.Size = UDim2.new(0, 34, 0, 18)
    SwitchBtn.AutoButtonColor = false
    SwitchBtn.Text = ""
    Instance.new("UICorner", SwitchBtn).CornerRadius = UDim.new(1, 0)

    local Circle = Instance.new("Frame")
    Circle.Parent = SwitchBtn
    Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Circle.Position = defaultState and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    Circle.Size = UDim2.new(0, 14, 0, 14)
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

    local activeState = defaultState

    SwitchBtn.MouseButton1Click:Connect(function()
        activeState = not activeState
        if activeState then
            TweenService:Create(SwitchBtn, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {BackgroundColor3 = Color3.fromRGB(52, 199, 89)}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {Position = UDim2.new(1, -16, 0.5, -7)}):Play()
        else
            TweenService:Create(SwitchBtn, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {BackgroundColor3 = Color3.fromRGB(35, 35, 35)}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
        end
        if callback then callback(activeState) end
    end)

    return SwitchBtn
end

--------------------------------------------------------------------------------
-- Helper Functions for Reliable Buying (Preventing Overlaps & Retrying)
--------------------------------------------------------------------------------
local activeBuyLoops = {}

local function startReliableBuyLoop(loopKey, getItemsFunc, buyRemoteFunc)
    if activeBuyLoops[loopKey] then return end
    activeBuyLoops[loopKey] = true
    task.spawn(function()
        while activeBuyLoops[loopKey] do
            local success, items = pcall(getItemsFunc)
            if success and items then
                for _, item in ipairs(items) do
                    if not activeBuyLoops[loopKey] then break end
                    local bought = false
                    for _ = 1, 3 do
                        if not activeBuyLoops[loopKey] then break end
                        local buySuccess = pcall(function()
                            buyRemoteFunc(item)
                        end)
                        if buySuccess then
                            bought = true
                            break
                        end
                        task.wait(0.1)
                    end
                    task.wait(bought and 0.15 or 0.3)
                end
            end
            task.wait(0.4)
        end
    end)
end

local function stopReliableBuyLoop(loopKey)
    activeBuyLoops[loopKey] = false
end

