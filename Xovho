local function getDynamicMerchantStock()
    local stock = {}
    local seen = {}

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, desc in ipairs(gui:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                        local text = desc.Text
                        if text and text ~= "" and #text < 40 then
                            for _, knownItem in ipairs(allMerchantItems) do
                                if text:find(knownItem, 1, true) and not seen[knownItem] then
                                    seen[knownItem] = true
                                    table.insert(stock, knownItem)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Part") then
            local name = obj.Name
            for _, knownItem in ipairs(allMerchantItems) do
                if name == knownItem and not seen[knownItem] then
                    seen[knownItem] = true
                    table.insert(stock, knownItem)
                end
            end
        end
    end

    if #stock == 0 then
        return allMerchantItems
    end
    return stock
end

