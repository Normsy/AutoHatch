-- Universal Helper: Strip Prefix Tags (e.g. [Gold], [Shiny], [])

local function getCleanItemName(name)
    if not name then return "" end
    local cleaned = name:gsub("^%s*%b[]%s*", "")
    cleaned = cleaned:match("^%s*(.-)%s*$")
    return cleaned
end

